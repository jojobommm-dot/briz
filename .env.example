# Скопировать в .env и поправить под машину
DEBUG=true
BASE_URL=http://127.0.0.1:8200

# Подпись кук входа. На сервере обязательно своя: openssl rand -hex 32
SECRET_KEY=dev-only-change-me

# Первый менеджер: создаётся при запуске, если сотрудников ещё нет.
# Остальные — venv\Scripts\python tools/staff.py add <логин> "Имя"
MANAGE_USER=manager
MANAGE_PASSWORD=

# База: по умолчанию SQLite в data/briz.db. На сервере — PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://briz:пароль@localhost:5432/briz
